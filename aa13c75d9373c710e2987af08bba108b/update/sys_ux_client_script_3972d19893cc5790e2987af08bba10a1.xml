        <script><![CDATA[/**
  * @param {params} params
  * @param {api} params.api
  * @param {TransformApiHelpers} params.helpers
  */
function evaluateProperty({api, helpers}) {
  var get = function (r) {
    try {
      return Number(api.data[r].output.data.GlideAggregate_Query[0].count) || 0;
    } catch (e) {
      return 0;
    }
  };
  var verified = get('kpi_verified');
  var total = get('kpi_total');
  if (!total) return '0%';
  return Math.round(verified / total * 100) + '%';
}]]></script>
